# All settings here override jail.conf

[DEFAULT]
# Ban IP for 1 hour (3600 seconds)
# Increase for repeat offenders using bantime.increment
bantime = 1h
ignoreself = true
# Time window to count failures
# Failures outside this window are not counted
findtime = 10m

# Number of failures before ban
# Lower values are more aggressive
maxretry = 4

# Backend for log monitoring
# auto = best available (systemd, pyinotify, or polling)
backend = pyinotify
logpath = /var/log/socklog/secure/current

# Email notifications (optional)
# Uncomment and configure if you want email alerts
# destemail = admin@example.com
# sender = fail2ban@example.com
# mta = sendmail

# Ban action - use the firewall backend on your system
# Debian/Ubuntu packages commonly default to nftables
banaction = cloudflare-token
banaction_allports = cloudflare-token

# Ignore these IP addresses (whitelist)
# Add your trusted IPs here
# before cloudflare: ignoreip = <redacted:old ignore list>
ignoreip = 127.0.0.1/8 ::1 <redacted:home-ip> 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# Enable ban time increment for repeat offenders
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 1w

[sshd]
# SSH jail
enabled = true
port = ssh,<redacted:ssh-port>
logpath = /var/log/socklog/secure/current
backend = pyinotify
maxretry = 3
bantime = 1h
banaction = ufw
banaction_allports = ufw

[nginx-http-auth]
enabled  = true
port     = http,https
filter   = nginx-http-auth
logpath  = /var/log/openresty/error.log
maxretry = 3

[nginx-botsearch]
enabled  = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/openresty/access.log
maxretry = 2

[nginx-limit-req]
enabled  = true
port     = http,https
filter   = nginx-limit-req
logpath  = /var/log/openresty/error.log
maxretry = 10

[nginx-4xx]
enabled = true
port     = http,https
filter   = nginx-4xx
logpath  = /var/log/openresty/access.log
maxretry = 3
findtime = 600

[nginx-forbidden]
enabled = true
port    = http,https
filter  = nginx-forbidden
logpath = /var/log/openresty/error.log
maxretry = 2

[nginx-sslerror]
enabled = false
port    = http,https
filter  = nginx-sslerror
logpath = /var/log/openresty/error.log

[nginx-badstuff]
enabled = true
port    = http,https
filter  = nginx-badstuff
logpath = /var/log/openresty/access.log
          /var/log/openresty/error.log
maxretry = 1
findtime = 600
bantime = 1w
